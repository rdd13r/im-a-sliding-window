#!/usr/bin/env python3
"""Generate the golden running-average file for the sliding-window tests.

Reads the default data set as one flat stream of integers (formatting is
typography), computes truncated integer averages over window 13 with step 3,
no partial windows, and writes one value per line.

Python `//` floors while Kotlin `Int` division truncates toward zero; for the
non-negative values in this data the results are identical.

Author: Claude Fable 5
"""

from datetime import datetime
from pathlib import Path
import subprocess

window_size = 13
step = 3
values_per_row = 50
rows_per_block = 50
source_file = Path("data/default_formatted_array.tsv")
golden_file = Path("data/default_formatted_array_13_by_3.tsv")


def assert_at_project_root() -> None:
    if not Path.cwd().samefile(subprocess.run(["git", "rev-parse", "--show-toplevel"],
                                              capture_output=True,
                                              text=True,
                                              check=True).stdout.strip()):
        raise SystemExit(
            f"This <run_average_13_by_3> is meant for IDE run configuration:\n"
            f"\t it must be invoked at the root of the project.\n"
        )


def running_average(data: list[int]) -> list[int]:
    windows = (len(data) - window_size) // step + 1
    return [sum(data[i * step: i * step + window_size]) // window_size
            for i in range(windows)]


def main() -> None:
    assert_at_project_root()

    data = [int(token) for token in source_file.read_text().split()]
    averages = running_average(data)

    if averages[:2] != [436, 471]:
        raise SystemExit(
            f"Hand-verified goldens do not match:\n"
            f"\t expected [436, 471], got {averages[:2]} - wrong source data?\n"
        )

    if golden_file.exists():
        file_name_rotated_out = "{}.{}".format(golden_file, datetime.now().strftime("%Y%m%d-%H%M%S"))
        golden_file.rename(file_name_rotated_out)
        print(f"Rotated existing to {file_name_rotated_out}\n")

    rows = ["\t".join(map(str, averages[i: i + values_per_row]))
            for i in range(0, len(averages), values_per_row)]
    blocks = ("\n".join(rows[i: i + rows_per_block])
              for i in range(0, len(rows), rows_per_block))
    golden_file.write_text("\n\n".join(blocks) + "\n")
    print(f"Wrote {len(averages)} averages (window {window_size}, step {step}) to {golden_file}")


if __name__ == "__main__":
    main()
