#!/usr/bin/env python3
"""Generate the sliding-window input data set.

Writes N matrices of X-by-X random integers (0-999) as tab-separated
values, with a blank line between matrices. Seeded for reproducibility.

Usage:
    generate [-s SIZE] [-c COUNT] [-d SEED] [-f FILE]
"""

import argparse
import random
import subprocess
from datetime import datetime
from pathlib import Path
from collections.abc import Iterator

DEFAULT_MATRIX_SIZE = 50
DEFAULT_MATRIX_COUNT = 40
DEFAULT_RANDOM_SEED = 42
DEFAULT_DATA_FILE_NAME = "formatted_array.tsv"
DATA_DIRECTORY = Path("data")

def assert_at_project_root() -> None:
    if not Path.cwd().samefile(subprocess.run(["git", "rev-parse", "--show-toplevel"],
                                              capture_output=True,
                                              text=True,
                                              check=True).stdout.strip()):
        raise SystemExit(
            f"This <generate> is meant for IDE run configuration:\n"
            f"\t it must be invoked at the root of the project.\n"
        )
    if not DATA_DIRECTORY.is_dir():
        raise SystemExit(
            f"Data directory does not exist:\n"
            f"\t are you in the right place?\n"
        )


def matrix_lines(size: int, count: int, rng: random.Random) -> Iterator[str]:
    for block in range(count):
        if block:
            yield ""
        yield from ("\t".join(str(rng.randint(0, 999)) for _ in range(size)) for _ in range(size))

def main() -> None:
    assert_at_project_root()
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("-s", "--size", type=int, default=DEFAULT_MATRIX_SIZE, help=f"matrix dimension S (S-by-S), default {DEFAULT_MATRIX_SIZE}")
    parser.add_argument("-c", "--count", type=int, default=DEFAULT_MATRIX_COUNT, help=f"number of matrices, default {DEFAULT_MATRIX_COUNT}")
    parser.add_argument("-d", "--seed", type=int, default=DEFAULT_RANDOM_SEED, help=f"RNG seed, default {DEFAULT_RANDOM_SEED}. IMPORTANT: Seed generates the same sequence!")
    parser.add_argument("-f", "--file", type=Path, default=DEFAULT_DATA_FILE_NAME, help=f"formatted array to generate, default {DEFAULT_DATA_FILE_NAME}")
    args = parser.parse_args()

    data_file = DATA_DIRECTORY / args.file
    print(f"\nGenerating data file {data_file}")

    if data_file.exists():
        file_name_rotated_out = "{}.{}".format(data_file, datetime.now().strftime("%Y%m%d-%H%M%S"))
        data_file.rename(file_name_rotated_out)
        print(f"Rotated existing to {file_name_rotated_out}\n")

    matrix_size = args.size
    matrices_count = args.count
    random_generator = random.Random(args.seed)

    print(f"Writing data in {data_file}: {matrices_count} matrices {matrix_size} by {matrix_size}.\n")
    with data_file.open("w") as handle:
        handle.writelines(f"{line}\n" for line in matrix_lines(matrix_size, matrices_count, random_generator))


if __name__ == "__main__":
    main()
